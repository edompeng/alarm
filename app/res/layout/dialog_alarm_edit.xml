<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Alarm Time"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Native TimePicker -->
            <TimePicker
                android:id="@+id/tp_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:timePickerMode="spinner"
                android:layout_marginBottom="12dp" />

            <!-- Alarm Label Input -->
            <EditText
                android:id="@+id/et_alarm_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Alarm Label (e.g. Wake up)"
                android:maxLines="1"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <!-- Recurrence Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repeat Mode"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rg_repeat_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <RadioButton
                    android:id="@+id/rb_repeat_once"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ring Once (Default)"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_repeat_workdays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Statutory Workdays (法定工作日 / 调休补班)" />

                <RadioButton
                    android:id="@+id/rb_repeat_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom Days of Week" />
            </RadioGroup>

            <!-- Custom Days Row (Mon - Sun) -->
            <LinearLayout
                android:id="@+id/layout_custom_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <ToggleButton
                    android:id="@+id/tb_mon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textOn="M"
                    android:textOff="M"
                    android:text="M"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/tb_tue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textOn="T"
                    android:textOff="T"
                    android:text="T"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/tb_wed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textOn="W"
                    android:textOff="W"
                    android:text="W"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/tb_thu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textOn="T"
                    android:textOff="T"
                    android:text="T"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/tb_fri"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textOn="F"
                    android:textOff="F"
                    android:text="F"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/tb_sat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textOn="S"
                    android:textOff="S"
                    android:text="S"
                    android:textSize="12sp" />

                <ToggleButton
                    android:id="@+id/tb_sun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textOn="S"
                    android:textOff="S"
                    android:text="S"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons Pinned at Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_delete_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="#FF0000"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_cancel_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_save_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
