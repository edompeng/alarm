load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Keep Android application compilation and packaging inside the Bazel graph
# without adding another build system or a new third-party rule dependency.
genrule(
    name = "alarm_debug_apk",
    srcs = glob([
        "res/**/*",
        "src/**/*.java",
    ]) + [
        "AndroidManifest.xml",
        "//core:android_java_sources",
    ],
    outs = ["alarm_debug_apk.apk"],
    cmd = "$(location //scripts:build_apk.sh) --repo-root $$PWD --mode debug --output $@",
    tags = ["no-sandbox"],
    tools = [
        "//scripts:build_apk.sh",
        "//scripts:generate_version.sh",
    ],
)

genrule(
    name = "alarm_release_apk",
    srcs = glob([
        "res/**/*",
        "src/**/*.java",
    ]) + [
        "AndroidManifest.xml",
        "//core:android_java_sources",
    ],
    outs = ["alarm_release_apk.apk"],
    cmd = "$(location //scripts:build_apk.sh) --repo-root $$PWD --mode release --output $@",
    tags = ["no-sandbox"],
    tools = [
        "//scripts:build_apk.sh",
        "//scripts:generate_version.sh",
    ],
)

cc_library(
    name = "app_native",
    srcs = glob(["src/**/*.cc"], allow_empty = True),
    hdrs = glob(["src/**/*.h"], allow_empty = True),
    deps = [
        "//core:alarm_core",
        "//data:alarm_data",
    ],
)
