load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "android_java_sources",
    srcs = glob(["src/**/*.java"]),
)

cc_library(
    name = "alarm_core",
    srcs = glob(["src/**/*.cc"]),
    hdrs = glob(["src/**/*.h"]),
    deps = [
        "//data:alarm_data",
    ],
)
